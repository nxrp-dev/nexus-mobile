// Direct native Linux simulator build. Upstream source lists and build defines
// were reviewed against platform/linux/CMakeList.txt; no external build generator runs.
dialect "../nexus/projects/nxbuild/language/nxbuild.Language.nxscript";
module "../nexus/projects/nxbuild/nxbuild.environment.nxscript";

Project Nexus2DEngine TargetOS[linux] {
    Id: "NXRP.Nexus2D.Engine";
    RootDirectory: "../nexus";
    SourceRoot: "../nexus-mobile";
    OutputRoot: @Tools.OutputRoot + "/nexus2d/" + @Tools.Native.Name;
    Publishes Directories {
        Headers: [@Nexus2DEngine.SourceRoot + "/librtt/Corona", @Nexus2DEngine.SourceRoot + "/external/lua-5.1.3/src"];
        Libraries: [@Nexus2DEngine.OutputRoot];
    }
    LLVM Lua {
        CompilerPath: @Tools.Native.LLVMCompiler;
